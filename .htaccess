# ============================================================
#  .htaccess — AYS belge kökü davranışı
#
#  NEDEN VAR: 05.08.2026'da başka bir projenin (nymagro) FTP
#  senkronizasyonu yanlış hedefe çalıştı ve kendi .htaccess dosyasını
#  hesabın EV DİZİNİNE (/home/<kullanici>/) bıraktı. O dosya şunu
#  içeriyordu:
#
#      RewriteCond %{REQUEST_URI} !/public/
#      RewriteRule ^(.+)$ public/$1 [QSA,L]
#
#  Apache/LiteSpeed'de .htaccess kuralları ÜST DİZİNLERDEN MİRAS
#  ALINIR. Ev dizinindeki bu dosya hesaptaki tüm alan adlarını etkiledi
#  ve her isteği "public/" klasörüne çevirdi. AYS'de böyle bir klasör
#  olmadığı için sitenin tamamı — düz bir test.txt dahil — 404 verdi.
#
#  İLK DENEMEDE NEDEN YETMEDİ: Bu dosyada başta yalnızca DirectoryIndex
#  vardı. Alt dizindeki DirectoryIndex, üst dizinden gelen RewriteRule'u
#  iptal etmez; bu yüzden dosya doğru yerde olmasına rağmen site
#  açılmadı. Çözüm aşağıdaki "RewriteEngine On" satırı:
#
#  mod_rewrite'ta bir dizin KENDİ rewrite yapılandırmasını tanımladığı
#  anda, üst dizinin kuralları varsayılan olarak MİRAS ALINMAZ
#  (miras ancak "RewriteOptions Inherit" ile açıkça istenirse olur).
#  Yani tek bir "RewriteEngine On" satırı — altında hiç kural olmasa
#  bile — bu dizini yukarıdan gelen yönlendirmelere karşı yalıtır.
#
#  AYS "temiz URL" kullanmaz; adresler doğrudan .php dosyalarıdır
#  (/login.php, /dashboard.php ...). Bu yüzden hiçbir RewriteRule
#  gerekmiyor ve kasıtlı olarak eklenmedi — buradaki RewriteEngine
#  satırının tek amacı mirası kesmek.
# ============================================================

# Ana sayfa index.php olsun (üstteki yabancı dosyanın
# "DirectoryIndex public/index.php" satırını geçersiz kılar).
DirectoryIndex index.php index.html

# Üst dizinlerden gelen yönlendirme kurallarını kes. Bu dizin kendi
# rewrite bağlamını tanımladığı için ev dizinindeki kurallar buraya
# uygulanmaz. Altına bilerek hiçbir kural yazılmadı.
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>
